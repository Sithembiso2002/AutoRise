# ============================================================
# Auto Rise — Environment Template
# ============================================================
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` to version control.

# ---- App ----
APP_NAME="Auto Rise"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/BuyCar/public
APP_KEY=

# ---- Database (primary) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop_system
DB_USERNAME=root
DB_PASSWORD=

# ---- SQLite mirror ----
SQLITE_PATH=database/shop_system.sqlite
DB_FALLBACK=false
DB_FALLBACK_CONNECTION=sqlite

# ---- Sessions ----
SESSION_LIFETIME=120

# ---- Payments ----
PAYMENT_GATEWAY=mock
PAYMENT_CURRENCY=LSL
MOCK_PAYMENT_OUTCOME=

# ---- Stripe (fill in when ready) ----
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=