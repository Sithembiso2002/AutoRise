# ============================================================
# Auto Rise — Production Environment Template
# ============================================================
# Copy to `.env` on the production server and fill in real values.

# ---- App ----
APP_NAME="Auto Rise"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_KEY=

# ---- Database (production) ----
DB_CONNECTION=mysql
DB_HOST=sqlXXX.hosting-provider.com
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=

# ---- SQLite mirror ----
SQLITE_PATH=database/shop_system.sqlite
DB_FALLBACK=false
DB_FALLBACK_CONNECTION=sqlite

# ---- Sessions ----
SESSION_LIFETIME=120

# ---- Payments ----
PAYMENT_GATEWAY=mock
PAYMENT_CURRENCY=LSL
MOCK_PAYMENT_OUTCOME=success

# ---- Stripe ----
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=